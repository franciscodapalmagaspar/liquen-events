=\\"0\\" border=\\"0\\" width=\\"100%\\" style=\\"border-collapse:collapse;margin-top:16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\\">\\n  <tr><td class=\\"em-hair\\" style=\\"border-top:1px solid #ece7dc;padding-top:10px\\">\\n    <div class=\\"em-strong\\" style=\\"color:#2a2620;font-size:15px;font-weight:700;mso-line-height-rule:exactly;line-height:20px\\">Catarina Gaspar</div>\\n    <div class=\\"em-muted\\" style=\\"color:#8f8a7a;font-size:13px;font-style:italic;mso-line-height-rule:exactly;line-height:19px\\">Manager</div>\\n  </td></tr>\\n  <tr><td style=\\"padding-top:8px\\">\\n    <div style=\\"mso-line-height-rule:exactly;line-height:19px\\"><a class=\\"em-strong\\" href=\\"tel:+351919259820\\" style=\\"color:#2a2620;text-decoration:none;font-size:13px;white-space:nowrap\\">+351 919 259 820</a></div>\\n    <div style=\\"mso-line-height-rule:exactly;line-height:19px;font-size:13px\\"><a class=\\"em-link\\" href=\\"mailto:liquen.alentejo@gmail.com\\" style=\\"color:#1155cc;text-decoration:underline\\">liquen.alentejo@gmail.com</a></div>\\n    <div style=\\"mso-line-height-rule:exactly;line-height:19px;font-size:13px\\"><a class=\\"em-link\\" href=\\"https://liquen-events.com\\" style=\\"color:#1155cc;text-decoration:underline\\">liquen-events.com</a></div>\\n  </td></tr>\\n  <tr><td style=\\"padding-top:8px\\"><a href=\\"https://www.facebook.com/liquen.events\\" style=\\"text-decoration:none;display:inline-block\\"><img src=\\"cid:liquen-social-facebook\\" alt=\\"Facebook\\" width=\\"18\\" height=\\"18\\" style=\\"display:inline-block;width:18px;height:18px;border:0;vertical-align:middle\\"></a><span style=\\"display:inline-block;width:10px\\">&nbsp;</span><a href=\\"https://www.instagram.com/liquen.events\\" style=\\"text-decoration:none;display:inline-block\\"><img src=\\"cid:liquen-social-instagram\\" alt=\\"Instagram\\" width=\\"18\\" height=\\"18\\" style=\\"display:inline-block;width:18px;height:18px;border:0;vertical-align:middle\\"></a><span style=\\"display:inline-block;width:10px\\">&nbsp;</span><a href=\\"https://pt.linkedin.com/company/l%C3%ADquen-events\\" style=\\"text-decoration:none;display:inline-block\\"><img src=\\"cid:liquen-social-linkedin\\" alt=\\"LinkedIn\\" width=\\"18\\" height=\\"18\\" style=\\"display:inline-block;width:18px;height:18px;border:0;vertical-align:middle\\"></a></td></tr>\\n  <tr><td style=\\"padding-top:16px\\">\\n    <img src=\\"cid:liquen-banner\\" alt=\\"Líquen Events\\" width=\\"560\\" height=\\"168\\" style=\\"display:block;width:100%;max-width:560px;height:auto;border:0\\">\\n  </td></tr>\\n</table>\\n</div>",
